37815>>>    Procedure SetActionButtons
37818>>>        tWebNavigateData NavigateData
37818>>>        tWebNavigateData NavigateData
37818>>>        Boolean bHasRecord
37818>>>        Handle hoDD
37818>>>
37818>>>        Get Server to hoDD
37819>>>        Get GetNavigateData to NavigateData
37820>>>        Get HasRecord of hoDD to bHasRecord
37821>>>
37821>>>        // let's hide all buttons and then Show the ones we want
37821>>>        WebSet pbRender of oEditBtn to False
37822>>>        WebSet pbRender of oSaveBtn to False
37823>>>        WebSet pbRender of oCancelChangesBtn to False
37824>>>        WebSet pbRender of oDeleteBtn to False
37825>>>
37825>>>        If (NavigateData.bReadOnly) Begin
37827>>>            WebSet pbRender of oEditBtn to True
37828>>>        End
37828>>>>
37828>>>        Else Begin
37829>>>            WebSet pbRender of oSaveBtn to True
37830>>>            WebSet pbRender of oCancelChangesBtn to True
37831>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37832>>>        End
37832>>>>
37832>>>    End_Procedure
