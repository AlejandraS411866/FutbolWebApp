// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// ZoomJugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use NameValuePairFunctions.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cjugadorposicionDataDictionary.dd
Use cposicionDataDictionary.dd


Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    { WebProperty=Server }
    Property Integer piJugadorActual 0


    Object oliga_DD is a cligaDataDictionary
    End_Object 


    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 


    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 


    // DD independiente para mostrar el nombre de la posición en la lista inferior.
    // NO se cuelga de ojugador_DD para no limpiar el jugador al refrescar la lista.
    Object oposicionLista_DD is a cposicionDataDictionary
    End_Object


    // DD independiente para la tabla intermedia jugadorposicion.
    // Se filtra por piJugadorActual, no por DDO_Server a ojugador_DD.
    Object ojugadorposicionLista_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to oposicionLista_DD

        Procedure OnConstrain
            Integer iJugadorID

            WebGet piJugadorActual of oZoomJugador to iJugadorID

            If (iJugadorID > 0) Begin
                Constrain jugadorposicion.JugadorID EQ iJugadorID
            End
            Else Begin
                Constrain jugadorposicion.JugadorID EQ -1
            End
        End_Procedure
    End_Object


    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4


        Object ojugadorID is a cWebForm
            Entry_Item jugador.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object 


        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 


        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 


        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 


        Object oequipoNombre is a cWebForm
            Entry_Item equipo.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object 


        Object oligaNombre is a cWebForm
            Entry_Item liga.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Liga"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectLiga

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object 


        Object oEditarPosicionesBtn is a cWebButton
            Set piColumnSpan to 4
            Set piColumnIndex to 0
            Set psCaption to "Editar Posiciones"

            WebRegisterPath ntNavigateForward oSelectJugadorPosicion

            Procedure OnClick
                Integer iJugadorID

                Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID

                If (iJugadorID = 0) Begin
                    Send UserError "No hay ningún jugador seleccionado."
                    Procedure_Return
                End

                WebSet piJugadorActual of oZoomJugador to iJugadorID

                Send NavigatePath
            End_Procedure


            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iJugadorID
                String sJugadorID

                Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID
                Move iJugadorID to sJugadorID

                Get NamedValueAdd NavigateData.NamedValues "JugadorID" sJugadorID to NavigateData.NamedValues
            End_Procedure


            Procedure OnNavigateBack Handle hoCallback tWebNavigateData NavigateData
                Send RefrescarPosicionesJugador of oZoomJugador
            End_Procedure

        End_Object


        Object oListaPosicionesJugador is a cWebList
            Set Server to ojugadorposicionLista_DD
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set psCaption to "Posiciones del jugador"
            Set pbDataAware to True
            Set piOrdering to 1

            Object oColPosicionJugador is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Posición"
                Set piWidth to 300
            End_Object
        End_Object

    End_Object 


    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object 


        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object 


        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object 


        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
                Send RefrescarPosicionesJugador
            End_Procedure
        End_Object 

    End_Object 


    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure


    Procedure RefrescarPosicionesJugador
        Integer iJugadorID

        Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID

        If (iJugadorID > 0) Begin
            WebSet piJugadorActual of oZoomJugador to iJugadorID
        End
        Else Begin
            WebGet piJugadorActual of oZoomJugador to iJugadorID
        End

        If (iJugadorID = 0) Begin
            Procedure_Return
        End

        Send Rebuild_Constraints of ojugadorposicionLista_DD
        Send Clear of ojugadorposicionLista_DD
        Send Find of ojugadorposicionLista_DD FIRST_RECORD 1

        Send GridRefresh of oListaPosicionesJugador
    End_Procedure


    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure


    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure


    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Integer iJugadorID

        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject

        Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID

        If (iJugadorID > 0) Begin
            WebSet piJugadorActual of oZoomJugador to iJugadorID
        End

        Send SetActionButtons
        Send RefrescarPosicionesJugador
    End_Procedure

End_Object